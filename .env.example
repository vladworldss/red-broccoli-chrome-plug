# Copy to .env.local (gitignored) for local development only.
#
# Used ONLY by `make smoke-live` (tests/live) to run a real Gemini round trip.
# The extension itself never reads env vars: users paste their key in the
# Options page. scripts/build-store-zip.sh stashes every .env* during the
# store build and fails if any of these values appears in the package.
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# GEMMA_LIVE=1   # also run the (slow, minutes) Gemma live test with the Gemini key
