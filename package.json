{
  "name": "red-broccoli-chrome-plug",
  "displayName": "RedBroccoli: Lecture Concept Maps",
  "version": "0.4.0",
  "description": "Build a study concept map \u2014 key terms, definitions, prerequisites and timestamps \u2014 from the lecture video you are watching.",
  "private": true,
  "scripts": {
    "dev": "PARCEL_WORKERS=0 plasmo dev",
    "build": "PARCEL_WORKERS=0 plasmo build",
    "package": "PARCEL_WORKERS=0 plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "markmap-view": "^0.18.12",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "manifest": {
    "permissions": [
      "storage",
      "sidePanel"
    ],
    "host_permissions": [
      "https://generativelanguage.googleapis.com/*"
    ],
    "optional_host_permissions": [
      "https://api.mistral.ai/*",
      "https://api.groq.com/*",
      "https://openrouter.ai/*",
      "https://api.deepseek.com/*"
    ]
  }
}
